	<developers>
		<developer>
			<id>fredfeng</id>
			<name>Fred Feng</name>
			<email>paganini.fy@gmail.com</email>
			<organization>ChaconneAI</organization>
			<organizationUrl>https://github.com/chaconne-ai</organizationUrl>
		</developer>
